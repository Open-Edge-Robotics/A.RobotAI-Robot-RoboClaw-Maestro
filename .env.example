POSTGRES_DB=maestro
POSTGRES_USER=maestro
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432
MAESTRO_DATABASE_URL=postgresql+psycopg://maestro:change-me@localhost:5432/maestro
MAESTRO_AUTO_CREATE_SCHEMA=false
MAESTRO_HOST=0.0.0.0
MAESTRO_PORT=8000
MAESTRO_HEARTBEAT_TIMEOUT_SEC=15
MAESTRO_READ_TOKEN=
MAESTRO_CONTROL_TOKEN=
MAESTRO_ADMIN_TOKEN=
MAESTRO_ALLOWED_SKILLS_JSON=
MAESTRO_CONTROL_RATE_LIMIT_PER_MINUTE=120
MAESTRO_LOG_LEVEL=INFO
MAESTRO_EVENT_RETENTION_DAYS=30
# ── Maestro LLM provider ──────────────────────────────────────────
# 비워두면 자연어 goal API의 LLM planning 기능을 비활성화합니다.
# 지원값: ollama | openai | azure_openai | anthropic
MAESTRO_LLM_PROVIDER=
MAESTRO_LLM_MODEL=
MAESTRO_LLM_TIMEOUT_SEC=30
# Console 설정 메뉴에서 편집하는 planning 문서(역할, 스킬, MCP, troubleshooting, 로봇 프로필) 위치입니다.
# 로컬 실행: MAESTRO_KNOWLEDGE_DIR, Docker Compose: MAESTRO_KNOWLEDGE_HOST_DIR(호스트 경로)를 사용합니다.
MAESTRO_KNOWLEDGE_DIR=knowledge
MAESTRO_KNOWLEDGE_HOST_DIR=./knowledge
# true면 Plan의 각 Task를 스킬 하나 호출로 강제합니다(Behavior Tree 변환용). false면 자유 형식 Task를 허용합니다.
MAESTRO_PLAN_SINGLE_SKILL=true
# 한 Plan의 최대 Task 수(1~500). 구역 정리 패턴은 로봇당 1 + 3 x 구역 수 개를 만듭니다.
MAESTRO_PLAN_MAX_TASKS=100

# Ollama
MAESTRO_OLLAMA_BASE_URL=http://127.0.0.1:11434
# 기존 설정 하위 호환용입니다. 신규 설정은 MAESTRO_LLM_MODEL을 사용하세요.
MAESTRO_OLLAMA_MODEL=

# OpenAI
OPENAI_API_KEY=
MAESTRO_OPENAI_BASE_URL=https://api.openai.com/v1

# Azure OpenAI: MAESTRO_LLM_MODEL에는 Azure deployment 이름을 입력합니다.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21

# Anthropic
ANTHROPIC_API_KEY=
MAESTRO_ANTHROPIC_BASE_URL=https://api.anthropic.com/v1

# ── LangSmith 선택적 트레이싱 ─────────────────────────────────────
# 기본값은 비활성입니다. 구현/검증 시에만 true로 변경하세요.
MAESTRO_LANGSMITH_TRACING=false
# 개발 환경에서 prompt/응답 본문을 확인할 때만 true로 변경합니다.
MAESTRO_LANGSMITH_CAPTURE_CONTENT=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=robo-claw-maestro
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# 개발·인수 단계 1.0(100%), 운영 환경에서는 필요에 따라 낮춥니다.
LANGSMITH_TRACING_SAMPLING_RATE=1.0
# true면 prompt/응답 본문을 LangSmith에 보내지 않습니다.
# 상세 본문 검증이 필요하고 redaction을 확인한 개발 환경에서만 false로 변경하세요.
LANGSMITH_HIDE_INPUTS=true
LANGSMITH_HIDE_OUTPUTS=true
# 여러 workspace를 사용하는 계정에서만 설정합니다.
LANGSMITH_WORKSPACE_ID=

MAESTRO_FLEET_CONTROL_ENABLED=false
MAESTRO_FLEET_CONTROL_HOST=0.0.0.0
MAESTRO_FLEET_CONTROL_PORT=50053
MAESTRO_FLEET_TLS_CERTIFICATE=
MAESTRO_FLEET_TLS_PRIVATE_KEY=
MAESTRO_FLEET_TLS_CLIENT_CA=
# 개발망 RosGrpc endpoint입니다. 운영 환경에서는 인증 없는 endpoint를 노출하지 마세요.
MAESTRO_ROBOTS_JSON=[]
